# ═══════════════════════════════════════════════════════════════════════════════
# BIST Operations System - Environment Variables
# העתק קובץ זה לקובץ בשם .env.local ומלא את הערכים האמיתיים במחשב שלך
# קובץ .env.local מוגן ב-.gitignore ולעולם לא יעלה ל-GitHub
# ═══════════════════════════════════════════════════════════════════════════════

# 1. חיבור קריאה בלבד ל-DB של הסטודיו ב-Supabase (לשליפת לקוחות/לידים לצורך הצעת מחיר)
# שים לב: המערכת תבצע אך ורק שאילתות SELECT לקריאה בלבד מול מסד זה!
CRM_SOURCE_DATABASE_URL=postgresql://postgres.ruavrqoayurhwsmrmcne:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# (אופציונלי) Supabase URL ומפתח Anon לקריאת נתונים
CRM_SOURCE_SUPABASE_URL=https://ruavrqoayurhwsmrmcne.supabase.co
CRM_SOURCE_SUPABASE_ANON_KEY=your_anon_key_here

# 2. מסד הנתונים המקומי של המערכת החדשה (אופרציה, הצעות מחיר, עסקאות ותוצרים)
# קובץ SQLite מקומי בדיסק שלך ללא צורך בהתקנת שרת
LOCAL_DATABASE_URL=file:./bist_operations_local.db

# 3. הגדרות שרת פיתוח מקומי
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
